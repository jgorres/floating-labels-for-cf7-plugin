#. Description of the plugin
#: floating-labels-for-cf7.php
msgid "Turns placeholders and labels of Contact Form 7 fields into floating labels. Pure CSS, no JavaScript."
msgstr ""

#. Author of the plugin
#: floating-labels-for-cf7.php
msgid "Jörn Gorres"
msgstr ""

